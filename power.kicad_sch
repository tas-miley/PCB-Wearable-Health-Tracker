	)
	(text "6.2k R for ISET to be ~144 mA.\nBased on equation:\n\nIchrg = Kiset / Riset\n\nwhere desired charge is 1C\nfor 150 mAh LiPo. Ichrge is\n0.15 A. Kiset is 890 (typ)\nfrom datasheet."
		(exclude_from_sim no)
		(at 184.404 108.712 0)
